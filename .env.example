# ==============================================================================
# Text-to-SQL Analyst Environment Configuration (.env.example)
# ==============================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=text2sql
POSTGRES_USER=owner
POSTGRES_PASSWORD=change_this_owner_password
ANALYST_RO_PASSWORD=change_this_analyst_ro_password
ANALYST_PII_RO_PASSWORD=change_this_analyst_pii_ro_password
APP_RW_PASSWORD=change_this_app_rw_password

# OpenAI API Configuration (Required)
OPENAI_API_KEY=your-key-here

# Optional: Primary chat model for SQL generation, explanation, planning, and rewrites (default: gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: Text embedding model for document retrieval and indexing (default: text-embedding-3-small, dim=1536)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: DeepEval evaluation judge model (default: gpt-4o-mini)
JUDGE_MODEL=gpt-4o-mini

# Optional: Fallback model on the same key during rate-limits or temporary outages (e.g. gpt-4.1-mini)
OPENAI_MODEL_FALLBACK=gpt-4.1-mini

# Vector store dimensions (1536 for text-embedding-3-small)
EMBEDDING_DIMENSIONS=1536

# Business Date Literal Rule (Ensures reproducible evaluation)
AS_OF_DATE=2026-11-02

# Runtime & Guardrail Controls
ALLOW_PII=false
SCHEMA_MODE=rag
RERANK_ENABLED=true
GRADING_ENABLED=true
COMBINE_PLAN_REWRITE=false
MAX_ATTEMPTS=3
MAX_ROWS=100
MAX_PLAN_COST=50000.0

# Timeouts, Retries & Rate Limiting
RATE_LIMIT_RPM=60
OPENAI_TIMEOUT_SECONDS=30.0
OPENAI_MAX_RETRIES=3
